{
  "name": "@fables092/opencode-mem0",
  "version": "1.0.1",
  "description": "OpenCode plugin that gives coding agents persistent memory using mem0 self-hosted Docker backend",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opencode-mem0": "dist/cli.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && bun build ./src/cli.ts --outfile ./dist/cli.js --target node && tsc --emitDeclarationOnly",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "mem0",
    "memory",
    "ai",
    "coding-agent"
  ],
  "author": "Falbes332",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Falbes332/opencode-mem0.git"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.162"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "chat.message",
      "event"
    ]
  },
  "files": [
    "dist"
  ]
}
